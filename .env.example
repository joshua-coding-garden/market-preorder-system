# ============================================================
# 市集預購系統｜環境變數
# 複製成 .env 後填入實際值： cp .env.example .env
# ============================================================

# ---------- 基本（Sprint 0 起必要） ----------
NODE_ENV=development
TZ=Asia/Taipei

# API 服務
API_PORT=3000
API_HOST=0.0.0.0

# 對外網址（LINE callback、圖文選單、推播連結都用這個）
# 本機開發填 http://localhost:5173
WEB_URL=http://localhost:5173

# 前端呼叫 API 的位址；本機開發留空（走 Vite proxy 的同源 /api）
VITE_API_BASE_URL=

# 資料庫（docker compose 起的 Postgres 對應 5433 埠）
DATABASE_URL=postgresql://market:market@localhost:5433/market_preorder?schema=public
# 測試資料庫（pnpm test 使用；請勿指向開發資料庫，測試會清空資料）
TEST_DATABASE_URL=postgresql://market:market@localhost:5433/market_preorder_test?schema=public

# 自簽 session JWT 的密鑰（32 字以上隨機字串）
# 產生方式： node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-please-32chars-min
# 正式環境（HTTPS）請設 true
COOKIE_SECURE=false

# ---------- LINE（Sprint 0 起必要：登入） ----------
# ⚠️ LINE Login channel 與 Messaging API channel 必須建立在「同一個 Provider」底下。
#    不同 Provider 取得的 userId 不同且無法搬遷，事後無法修正。
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 需與 LINE Login channel 設定的 Callback URL 完全一致
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/api/auth/line/callback

# ---------- ⚠️ 規格外：暫時的 Google 登入通道（委託方 2026-09-12 指示） ----------
# 正式身分來源仍是 LINE Login。Google 帳號以 `google:{sub}` 形式寫進 app_user.line_user_id，
# 收不到 LINE 推播；LINE channel 就緒後請改回 LINE 登入並移除這三項。
# 建立方式：Google Cloud Console → API 和服務 → 憑證 → 建立 OAuth 2.0 用戶端 ID（網頁應用程式）
#   已授權的重新導向 URI 要與 GOOGLE_CALLBACK_URL 完全一致
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------- ⚠️ 規格外：暫時的帳號密碼註冊／登入（委託方 2026-09-12 指示） ----------
# LINE／Google channel 都還沒申請下來時，用這條路徑先進系統測試。
# 憑證存在獨立的 local_credential 表，app_user 不受影響；
# 之後接上 LINE Login 時 `DROP TABLE local_credential;` 即可移除乾淨。
#
# ⚠️ 這種帳號收不到 LINE 推播。正式環境接上 LINE Login 後請設回 false。
# ⚠️ 系統還沒有任何管理員時，第一個註冊的帳號會自動成為管理員。
LOCAL_LOGIN_ENABLED=false

# ---------- ⚠️ 規格外：廠商後台的身分模擬（委託方指示） ----------
# 開啟後管理員可在「帳號與權限」頁以其他身分檢視（權限是真的降級，後端一併生效）。
# 正式環境請保持 false。
ENABLE_IMPERSONATION=false

# ---------- LINE Messaging API（Sprint 5 起必要） ----------
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# LIFF app（Sprint 5 起必要；LINE 內建瀏覽器登入用）
LIFF_ID=
# 每月訊息額度上限（D-10；LINE 官方 quota API 取不到時的 fallback）
LINE_MONTHLY_MESSAGE_QUOTA=200
# 當日取貨提醒推播時間（台北時間整點；Q-06 預設 8）
PICKUP_REMINDER_HOUR=8

# ---------- 圖片儲存（Sprint 2 起必要） ----------
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
